<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================== -->
    <!-- Template: Nginx Web Server / Static Site      -->
    <!-- ============================================== -->
    <record id="template_nginx" model="service.template">
        <field name="name">Nginx Web Server</field>
        <field name="code">nginx</field>
        <!-- Los servicios están dimensionados abajo: una instancia nueva nace
             con esos topes aplicados. No afecta a las instancias ya creadas. -->
        <field name="resource_limits_default" eval="True"/>
        <field name="image" type="base64" file="steer_infra_suite/static/img/templates/nginx.png"/>
        <field name="description">Servidor web Nginx para sitios estáticos o como reverse proxy.</field>
        <field name="category">networking</field>
        <field name="version">alpine</field>
        <field name="service_code">nginx</field>
        <field name="tag_ids" eval="[Command.set([ref('steer_infra_suite.tag_proxy'), ref('steer_infra_suite.tag_networking')])]"/>
        <field name="is_web_app">True</field>
        <field name="is_global">True</field>
        <field name="active">True</field>
        <field name="requires_database">False</field>
        <field name="database_type">none</field>
        <field name="requires_backup">True</field>
        <field name="backup_mode">standard</field>
        <field name="docker_compose_template"><![CDATA[services:
  nginx:
    image: nginx:{{ version | default('alpine') }}
    container_name: {{ INSTANCE_CODE }}
    ports:
      - "{{ PORT_HTTP }}:80"
      - "{{ PORT_HTTPS }}:443"
    volumes:
      - ./html:/usr/share/nginx/html:ro
      - ./conf.d:/etc/nginx/conf.d:ro
      - ./ssl:/etc/nginx/ssl:ro
    restart: unless-stopped
    networks:
      - steer-proxy-network
    healthcheck:
      # Liveness, no content-check: pasa con CUALQUIER respuesta HTTP (incluido 403 de
      # un webroot vacío recién desplegado, 404 de un SPA o 5xx de un reverse-proxy con
      # upstream caído) y falla solo si nginx no responde (connection refused / hung).
      # 'curl -f' rompía esto: marcaba unhealthy cualquier deploy que no devolviera 2xx.
      test: ["CMD-SHELL", "curl -s -o /dev/null --max-time 5 http://localhost:80/ || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s

networks:
  steer-proxy-network:
    external: true
]]></field>
        <field name="backup_script"></field>
        <field name="restore_script"></field>
    </record>

    <!-- Puertos del template Nginx -->
    <record id="template_nginx_port_http" model="service.template.port">
        <field name="template_id" ref="template_nginx"/>
        <field name="code">http</field>
        <field name="name">HTTP</field>
        <field name="default_port">80</field>
        <field name="sequence">10</field>
        <field name="traefik_routed" eval="True"/>
        <field name="expose_to_host" eval="True"/>
    </record>

    <record id="template_nginx_port_https" model="service.template.port">
        <field name="template_id" ref="template_nginx"/>
        <field name="code">https</field>
        <field name="name">HTTPS</field>
        <field name="default_port">443</field>
        <field name="sequence">20</field>
        <field name="expose_to_host" eval="True"/>
    </record>

    <!-- Variables del template Nginx -->
    <record id="template_nginx_var_version" model="service.template.variable">
        <field name="template_id" ref="template_nginx"/>
        <field name="name">version</field>
        <field name="display_name">Versión de Nginx</field>
        <field name="var_type">selection</field>
        <field name="selection_options">alpine,latest,1.25,1.24,1.23</field>
        <field name="default_value">alpine</field>
        <field name="required">False</field>
        <field name="sequence">10</field>
    </record>

    <!-- Volúmenes del template Nginx -->
    <record id="template_nginx_vol_html" model="service.template.volume">
        <field name="template_id" ref="template_nginx"/>
        <field name="name">Contenido Web</field>
        <field name="local_path">./html</field>
        <field name="owner">101:101</field>
        <field name="permissions">755</field>
        <field name="sequence">10</field>
    </record>

    <record id="template_nginx_vol_conf" model="service.template.volume">
        <field name="template_id" ref="template_nginx"/>
        <field name="name">Configuración Nginx</field>
        <field name="local_path">./conf.d</field>
        <field name="owner">101:101</field>
        <field name="permissions">755</field>
        <field name="sequence">20</field>
    </record>

    <record id="template_nginx_vol_ssl" model="service.template.volume">
        <field name="template_id" ref="template_nginx"/>
        <field name="name">Certificados SSL</field>
        <field name="local_path">./ssl</field>
        <field name="owner">101:101</field>
        <field name="permissions">700</field>
        <field name="sequence">30</field>
    </record>

    <!-- Archivos de configuración del template Nginx -->
    <record id="template_nginx_config_default" model="service.template.config.file">
        <field name="template_id" ref="template_nginx"/>
        <field name="name">Configuración Nginx por Defecto</field>
        <field name="filename">default.conf</field>
        <field name="path">./conf.d/</field>
        <field name="syntax_mode">nginx</field>
        <field name="sequence">10</field>
        <field name="description">Configuración del servidor Nginx para el sitio</field>
        <field name="content_template"><![CDATA[# Configuración generada para {{ instance.name }}
# {{ generated_at }}

server {
    listen 80;
    server_name {{ instance.full_domain | default('localhost') }};

    root /usr/share/nginx/html;
    index index.html index.htm;

    # Logs
    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;

    # Gzip
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml;

    # Raíz del sitio: mientras html/ no tenga index.html se muestra la página de
    # bienvenida (vive en conf.d/steer/, fuera del contenido del sitio). Subir un
    # index.html la reemplaza sola, sin reiniciar; la plantilla nunca escribe en html/.
    location = / {
        index index.html index.htm /__steer/welcome.html;
    }

    location = /__steer/welcome.html {
        internal;
        alias /etc/nginx/conf.d/steer/welcome.html;
        add_header Cache-Control "no-store";
    }

    location / {
        try_files $uri $uri/ =404;
    }

    # Cache de archivos estáticos
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|woff|woff2)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
]]></field>
    </record>


    <record id="template_nginx_config_welcome" model="service.template.config.file">
        <field name="template_id" ref="template_nginx"/>
        <field name="name">Página de bienvenida</field>
        <field name="filename">welcome.html</field>
        <field name="path">./conf.d/steer/</field>
        <field name="syntax_mode">xml</field>
        <field name="sequence">20</field>
        <field name="description">Se muestra en la raíz del sitio mientras html/ no tenga un index.html. No hace falta borrarla: el index.html del sitio la reemplaza.</field>
        <field name="content_template"><![CDATA[<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ instance.name | e }}</title>
<style>
  :root { color-scheme: light dark; --bg: #f4f6f8; --card: #ffffff; --ink: #1c2530; --muted: #5b6878; --line: #dde3ea; --ok: #1f8a5b; }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #11161c; --card: #19212a; --ink: #e6ebf0; --muted: #9aa7b5; --line: #2a3542; --ok: #4cc38a; }
  }
  * { box-sizing: border-box; }
  body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 24px 16px;
         background: var(--bg); color: var(--ink);
         font: 16px/1.55 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  main { width: 100%; max-width: 560px; background: var(--card); border: 1px solid var(--line);
         border-radius: 10px; padding: 32px 28px; }
  .status { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600;
            letter-spacing: .04em; text-transform: uppercase; color: var(--ok); }
  .status::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--ok); }
  h1 { margin: 12px 0 8px; font-size: 26px; line-height: 1.25; overflow-wrap: anywhere; }
  p { margin: 0 0 14px; color: var(--muted); }
  code { font: 14px/1.4 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; color: var(--ink);
         background: var(--bg); border: 1px solid var(--line); border-radius: 4px; padding: 1px 5px; }
  footer { margin-top: 22px; padding-top: 14px; border-top: 1px solid var(--line); font-size: 13px; color: var(--muted); }
</style>
</head>
<body>
<main>
  <span class="status">Online</span>
  <h1>{{ instance.name | e }} is up</h1>
  <p>Nginx is running and this address already reaches it. This page stands in until the site has its own content.</p>
  <p>To publish the site, put its files in the <code>html/</code> folder of the instance. As soon as there is an <code>index.html</code> there, it replaces this page. No restart needed.</p>
  <footer>Served by Nginx, deployed from the Steer panel.</footer>
</main>
</body>
</html>
]]></field>
    </record>


    <!-- Config Docker por servicio — defaults recomendados (VPS 2-8 GB) -->
    <!-- ========== Nginx (template_nginx) ========== -->
    <record id="svcfg_nginx_nginx" model="service.template.service.config">
        <field name="template_id" ref="template_nginx"/>
        <field name="service_name">nginx</field>
        <field name="sequence">10</field>
        <field name="memory_limit">256m</field>
        <field name="cpu_limit">0.5</field>
        <field name="memory_reservation">128m</field>
        <field name="log_max_size">20m</field>
        <field name="log_max_file">3</field>
        <field name="restart_policy">unless-stopped</field>
    </record>
</odoo>
