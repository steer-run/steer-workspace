#!/usr/bin/env python3
"""steer-credential: use the credentials kept in a Steer panel without copying their secrets.

The panel stores tokens and keys (Configuration -> Credentials). An agent connection with the
"Credentials" level at Operate can use the ones it reaches; this helper asks the panel for the
secret right when a tool needs it and hands it straight to that tool, so the value never shows up
in a terminal, a transcript or a file.

Configuration (the same variables as the rest of this workspace):
  STEER_PANEL_URL         e.g. https://panel.example.com
  STEER_MCP_TOKEN         the agent connection token (or STEER_MCP_TOKEN_FILE, a file holding it)

Commands:
  git get                       git credential helper protocol (see below); store/erase are ignored
  docker-login NAME [REGISTRY]  docker login with the credential NAME, the secret through stdin
  env NAME VAR -- COMMAND...    run COMMAND with the secret of NAME in the environment variable VAR

Git, once per machine (the empty helper first: it drops the other helpers for github.com, so a
keychain or ~/.git-credentials neither keeps a copy of the token nor hands back an old one):
  git config --global credential.https://github.com.helper ''
  git config --global --add credential.https://github.com.helper '!steer-credential git'
  git config --global credential.https://github.com.useHttpPath true
Then `git push` to https://github.com/owner/repo uses the credential whose target is owner/repo
(or owner). The same works for gitlab.com.

docker-login leaves the registry token where docker keeps it: ~/.docker/config.json unless a
credential store (credsStore) is configured. Run `docker logout` when you are done.

Exit codes: 0 ok (for git, also "no matching credential": git then asks its other helpers),
1 error, 2 bad usage.
"""

import json
import os
import subprocess
import sys
import urllib.error
import urllib.request

TIMEOUT = 20


def _config():
    url = (os.environ.get("STEER_PANEL_URL") or "").rstrip("/")
    token = os.environ.get("STEER_MCP_TOKEN") or ""
    archivo = os.environ.get("STEER_MCP_TOKEN_FILE")
    if not token and archivo:
        try:
            with open(os.path.expanduser(archivo), encoding="utf-8") as fh:
                token = fh.read().strip()
        except OSError as e:
            raise SystemExit("steer-credential: cannot read STEER_MCP_TOKEN_FILE (%s)" % e.strerror)
    if not url or not token:
        raise SystemExit("steer-credential: set STEER_PANEL_URL and STEER_MCP_TOKEN (or STEER_MCP_TOKEN_FILE)")
    return url, token


def _pedir(body):
    """The panel answer for {"name": ...} or {"url": ...}; None when nothing matches."""
    url, token = _config()
    req = urllib.request.Request(
        url + "/api/v1/credentials/use", data=json.dumps(body).encode("utf-8"), method="POST",
        headers={"Content-Type": "application/json", "Authorization": "Bearer " + token,
                 "X-Steer-Client": "steer-credential 1"})
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
            datos = json.loads(resp.read().decode("utf-8"))
        if not isinstance(datos, dict) or "secret" not in datos:
            raise SystemExit("steer-credential: unexpected answer from the panel")
        return datos
    except ValueError:
        raise SystemExit("steer-credential: the panel did not answer JSON (check STEER_PANEL_URL)")
    except (TimeoutError, OSError) as e:
        if isinstance(e, urllib.error.URLError):
            if isinstance(e, urllib.error.HTTPError):
                return _error_http(e)
            raise SystemExit("steer-credential: cannot reach the panel (%s)" % e.reason)
        raise SystemExit("steer-credential: the panel did not answer in time")


def _error_http(e):
    if e.code == 404:
        return None
    try:
        detalle = json.loads(e.read().decode("utf-8")).get("message") or ""
    except (ValueError, AttributeError, OSError):
        detalle = ""
    raise SystemExit("steer-credential: the panel answered %s %s" % (e.code, detalle))


def _git(args):
    if not args or args[0] != "get":
        return 0  # store / erase: the panel is the source of truth
    campos = {}
    for linea in sys.stdin.read().splitlines():
        clave, _sep, valor = linea.partition("=")
        if clave:
            campos[clave] = valor
    host, path = campos.get("host", ""), campos.get("path", "")
    if not host or not path:
        return 0  # without useHttpPath git does not say which repository; nothing to match
    cred = _pedir({"url": "https://%s/%s" % (host, path)})
    if not cred:
        return 0
    sys.stdout.write("username=%s\npassword=%s\n" % (cred.get("username") or "x-access-token", cred["secret"]))
    return 0


def _uso():
    sys.stderr.write(__doc__)
    raise SystemExit(2)


def _docker_login(args):
    if not args:
        _uso()
    cred = _pedir({"name": args[0]})
    if not cred:
        raise SystemExit("steer-credential: no credential named %r for this connection" % args[0])
    cmd = ["docker", "login", "-u", cred.get("username") or "", "--password-stdin"] + args[1:2]
    return subprocess.run(cmd, input=cred["secret"].encode("utf-8"), check=False).returncode


def _env(args):
    if len(args) < 4 or args[2] != "--":
        _uso()
    cred = _pedir({"name": args[0]})
    if not cred:
        raise SystemExit("steer-credential: no credential named %r for this connection" % args[0])
    entorno = dict(os.environ, **{args[1]: cred["secret"]})
    return subprocess.run(args[3:], env=entorno, check=False).returncode


def main(argv):
    comandos = {"git": _git, "docker-login": _docker_login, "env": _env}
    if len(argv) < 2 or argv[1] not in comandos:
        sys.stderr.write(__doc__)
        return 2
    return comandos[argv[1]](argv[2:])


if __name__ == "__main__":
    sys.exit(main(sys.argv))
